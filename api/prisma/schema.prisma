// The database: PostgreSQL. Models are PascalCase, tables and columns snake_case through @@map / @map.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// How a session was opened.
enum SignInMethod {
  PASSWORD
  PASSKEY
}

// What a passkey challenge was handed out for: making the first passkey at setup, or signing in.
enum AuthChallengePurpose {
  SETUP
  SIGN_IN
}

// The one account (ADR 0002). The row appears when setup finishes; yarn auth:reset empties its password and removes
// its passkeys, and the next setup fills it again.
model Account {
  id             Int      @id @default(autoincrement())
  // The random WebAuthn user handle (base64url) every passkey of this account carries. Never the row id.
  webauthnUserId String   @map("webauthn_user_id")
  // An argon2id hash in PHC form ($argon2id$v=19$m=...,t=...,p=...$salt$hash). Never the password itself. Null when
  // the account signs in with passkeys only.
  passwordHash   String?  @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  passkeys Passkey[]

  @@map("accounts")
}

// One passkey. Only its public key lives here; the private key never leaves the user's device or passkey manager.
model Passkey {
  id           Int       @id @default(autoincrement())
  // The credential id the authenticator chose (base64url).
  credentialId String    @unique(map: "passkeys_credential_id_uidx") @map("credential_id")
  accountId    Int       @map("account_id")
  publicKey    Bytes     @map("public_key")
  // The signature counter the authenticator reported last; a lower one later means a cloned key.
  counter      Int
  // How the browser can reach it ("internal", "hybrid", "usb"...).
  transports   String[]
  // Backed up by a passkey manager (iCloud Keychain, Bitwarden...), so it survives losing one device.
  isSynced     Boolean   @map("is_synced")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "passkeys_account_id_idx")
  @@map("passkeys")
}

// One signed-in browser. The cookie holds a random token; only its SHA-256 is stored, so a leaked database copy
// cannot be turned back into a working cookie.
model Session {
  id           Int          @id @default(autoincrement())
  tokenHash    String       @unique(map: "sessions_token_hash_uidx") @map("token_hash")
  signInMethod SignInMethod @map("sign_in_method")
  // When the user signed in: the absolute lifetime is measured from here.
  signedInAt   DateTime     @map("signed_in_at") @db.Timestamptz(3)
  // Moved forward at most once an hour while the session is used; the idle timeout is measured from here.
  lastSeenAt   DateTime     @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastSeenAt], map: "sessions_last_seen_at_idx")
  @@map("sessions")
}

// A random value handed to the browser for one passkey ceremony. Used once, then deleted; it expires in minutes.
model AuthChallenge {
  id             Int                  @id @default(autoincrement())
  challenge      String               @unique(map: "auth_challenges_challenge_uidx")
  purpose        AuthChallengePurpose
  // SETUP only: the WebAuthn user handle the new passkey is made for, kept until the account row exists.
  webauthnUserId String?              @map("webauthn_user_id")
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "auth_challenges_expires_at_idx")
  @@map("auth_challenges")
}

// The one-time code in the setup link the server prints. Only its SHA-256 is kept, and only until setup finishes.
model SetupCode {
  id        Int      @id @default(autoincrement())
  codeHash  String   @unique(map: "setup_codes_code_hash_uidx") @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("setup_codes")
}

// Whether a reading's email went out (docs/GLOSSARY.md: Send, Sent, Failed). Every reading starts not sent.
enum ReadingStatus {
  NOT_SENT
  SENT
  FAILED
}

// One reading of the meter, kept exactly as read: text, never a number, so leading zeros survive.
model Reading {
  id            Int           @id @default(autoincrement())
  // Digits only, leading zeros kept ("00123").
  digits        String
  // The day the meter showed these digits. A calendar day, no time and no time zone.
  date          DateTime      @db.Date
  status        ReadingStatus @default(NOT_SENT)
  // When the mail service accepted its email; null until it is sent.
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(3)
  // The email exactly as it went out, the user's edits included; null until it is sent, and for readings sent before
  // these were kept.
  sentFrom      String?       @map("sent_from")
  sentTo        String?       @map("sent_to")
  sentSubject   String?       @map("sent_subject")
  sentBody      String?       @map("sent_body")
  sentWithPhoto Boolean?      @map("sent_with_photo")
  // What the reading cost (docs/GLOSSARY.md: Cost), in euro cents, so it is a whole number and never a rounded float;
  // never below 0 (a check in the migration). Null until the user adds one. Never part of the reading's email.
  costCents     Int?          @map("cost_cents")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  photo Photo?
  bill  Bill?

  // The history reads newest first: by date, then by the order it was saved.
  @@index([date(sort: Desc), id(sort: Desc)], map: "readings_date_id_idx")
  @@map("readings")
}

// The Hotmail sign-in the server sends mail with (ADR 0001): send-only, renewed by the server itself. One row at most:
// yarn mail:connect replaces it, and a refresh Microsoft refuses (revoked, expired) deletes it. The tokens are kept as
// Microsoft gave them: the server must hand them back, so they cannot be hashed. Never logged, never sent to a browser.
model MailConnection {
  id                   Int      @id @default(autoincrement())
  // Long-lived; traded for a new access token (and a new refresh token) whenever the access token runs out.
  refreshToken         String   @map("refresh_token")
  // Short-lived (about an hour): the bearer token for Graph's sendMail.
  accessToken          String   @map("access_token")
  accessTokenExpiresAt DateTime @map("access_token_expires_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mail_connections")
}

// The photo a reading was taken from: a JPEG the phone already shrank (longest side 2000 px, under 3 MB), kept as a
// file in UPLOADS_DIR. It is uploaded first and linked when its reading is saved; until then readingId is null.
model Photo {
  id        Int      @id @default(autoincrement())
  // The file's name in UPLOADS_DIR, chosen by the server (a random UUID), never by the client.
  fileName  String   @unique(map: "photos_file_name_uidx") @map("file_name")
  sizeBytes Int      @map("size_bytes")
  readingId Int?     @unique(map: "photos_reading_id_uidx") @map("reading_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Deleting a reading deletes its photo row; the file itself is removed by the code that deletes the reading.
  reading Reading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@map("photos")
}

// What kind of file a bill is. The server reads it from the file's first bytes, never from what the client says.
enum BillFileType {
  PDF
  JPEG
  PNG
}

// The provider's bill for one reading (docs/GLOSSARY.md: Bill): a PDF, JPEG or PNG of at most 10 MB, kept as a file in
// UPLOADS_DIR beside the photos. It is uploaded first and linked when its reading is updated with its id; until then
// readingId is null. Never part of the reading's email.
model Bill {
  id        Int          @id @default(autoincrement())
  // The file's name in UPLOADS_DIR, chosen by the server (a random UUID and the type's extension), never by the client.
  fileName  String       @unique(map: "bills_file_name_uidx") @map("file_name")
  fileType  BillFileType @map("file_type")
  sizeBytes Int          @map("size_bytes")
  readingId Int?         @unique(map: "bills_reading_id_uidx") @map("reading_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Deleting a reading deletes its bill row; the file itself is removed by the code that deletes the reading.
  reading Reading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@map("bills")
}

// The app's own settings, set on the Settings page (ADR 0003). One row at most, id 1, made the first time the user
// saves: until then, and while a field is empty, that setting is not set.
model Settings {
  id            Int      @id @default(1)
  // The provider's one address: every reading is emailed here. No default: the user sets it.
  providerEmail   String?  @map("provider_email")
  // Every email's subject and body, with {reading} and {date} to fill in (docs/GLOSSARY.md: Template). The defaults
  // are a fresh install's, the same as DEFAULT_SUBJECT_TEMPLATE and DEFAULT_BODY_TEMPLATE in settings.template.ts.
  subjectTemplate String   @default("Leitura {date}") @map("subject_template")
  bodyTemplate    String   @default("Leitura - {reading} - {date}") @map("body_template")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}
