NODE_ENV=test
LOG_LEVEL=silent
PORT=0
# The server the tests run on. Each test file gets its own throwaway copy of the migrated database, named
# meter_test_<random>, from src/testGlobalSetup.ts and src/setupTests.ts; the name in this URL is never used.
DATABASE_URL=postgresql://meter:meter@localhost:5432/meter_test
# The origin the test passkey signs for (src/modules/auth/TestPasskey.ts).
APP_ORIGIN=http://localhost:5173
# Microsoft is faked in the tests (src/modules/mail/mail.microsoftIdentity.mock.ts); any id will do.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Graph is faked in the tests too (src/modules/mail/mail.microsoftGraph.mock.ts): nothing is ever sent here.
MAIL_FROM=me@hotmail.example
# Where the tests keep photos. Emptied at the start and the end of every run (src/testGlobalSetup.ts).
UPLOADS_DIR=./data/test-uploads
