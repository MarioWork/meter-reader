NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
DATABASE_URL=postgresql://meter:meter@localhost:5432/meter_dev
# Proxies in front of the API (1 behind Caddy); 0 when it is reached directly, as in dev.
TRUST_PROXY_HOPS=0
# Browser origins allowed to call the API from elsewhere, comma-separated; empty turns CORS off (same origin).
CORS_ORIGINS=
# Where the user opens the app (the web dev server in dev). The setup link points here; passkeys belong to its host.
APP_ORIGIN=http://localhost:5173
# The Application (client) id of the app registered in Microsoft Entra (README, "Connecting Hotmail"). Not a secret.
MICROSOFT_CLIENT_ID=
