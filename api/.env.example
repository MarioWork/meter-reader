NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
DATABASE_URL=postgresql://meter:meter@localhost:5432/meter_dev
# Proxies in front of the API (1 behind Caddy); 0 when it is reached directly, as in dev.
TRUST_PROXY_HOPS=0
# Browser origins allowed to call the API from elsewhere, comma-separated; empty turns CORS off (same origin).
CORS_ORIGINS=
