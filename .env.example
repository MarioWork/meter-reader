# Copy to .env next to compose.yaml (never commit .env). Letters and digits only: it goes inside a database URL.
POSTGRES_PASSWORD=changeme123
# The Application (client) id of the app registered in Microsoft Entra (README, "Connecting Hotmail"). Not a secret.
MICROSOFT_CLIENT_ID=
# The water provider's address: every reading is emailed here. Required.
PROVIDER_EMAIL=readings@water-provider.example
# The subject of every reading's email.
MAIL_SUBJECT=test
