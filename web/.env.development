VITE_PROJECT_PATH='/'
VITE_PLAYWRIGHT=false
# Same origin as on the server: the Vite dev server proxies /api to the api on http://localhost:3000.
VITE_BASE_API_URL='/api'
# Mocks on, so `yarn dev` works with no api running. Set it to false in .env.development.local (git-ignored) to
# use the real api.
VITE_USE_MOCKS=true
