# Every VITE_* variable the app reads. None is a secret: they are built into the bundle.
# .env.development (committed) holds the dev values. To change one locally, copy this file to
# .env.development.local (git-ignored) and set only what differs.
# Base path the app is served from.
VITE_PROJECT_PATH='/'
# true under Playwright, which brings its own mocks (yarn dev:playwright sets it).
VITE_PLAYWRIGHT=false
# Base URL for every API call. /api is proxied to the api by Vite in dev and by Caddy on the server.
VITE_BASE_API_URL='/api'
# true starts MSW in the browser instead of calling the api.
VITE_USE_MOCKS=false
